{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "zachofalltrades",
  "main": "worker.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "CONTACT_TO_EMAIL": "support@zachofalltrades.co.za",
    "RESEND_FROM": "Zach of All Trades <support@zachofalltrades.co.za>",
    "RESEND_CLIENT_FROM": "Zach of All Trades <clients@zachofalltrades.co.za>"
  },
  "routes": [
    { "pattern": "zachofalltrades.co.za", "custom_domain": true }
  ]
}
