# Optional quote form delivery. The site is fully static without these.
# Leave blank to keep the on-page fallback (no fake "sent" confirmation).

# Formspree, Getform, Basin, or any JSON POST endpoint:
VITE_FORM_ENDPOINT=

# Web3Forms access key (posts to https://api.web3forms.com/submit):
VITE_FORM_ACCESS_KEY=

# Mailto fallback if no endpoint is configured:
VITE_CONTACT_EMAIL=
